<Application x:Class="DepositoDental.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DepositoDental"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- 1. Cargar el TEMA COMPLETO de Material Design (colores y base). -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Green" />

                <!-- 2. Cargar tus archivos de recursos personalizados. _Styles.xaml ahora es autosuficiente. -->
                <ResourceDictionary Source="/Resources/Themes/_Colors.xaml" />
                <ResourceDictionary Source="/Resources/Themes/_Icons.xaml" />
                <ResourceDictionary Source="/Resources/Themes/_Styles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <!-- NOTA: Ya no es necesario aplicar los estilos aquí.
                 Para usarlos, hazlo directamente en tu XAML, por ejemplo:
                 <Button Style="{StaticResource App.Button.Primary}" />
                 <DataGrid Style="{StaticResource App.DataGrid}" />
            -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
