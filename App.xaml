<Application x:Class="DepositoDental.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DepositoDental">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MahApps.Metro -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Steel.xaml" />

                <ResourceDictionary Source="/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="/Resources/Themes/LightColors.xaml" />
                <ResourceDictionary Source="/Resources/Themes/LightTheme.xaml" />
                <ResourceDictionary Source="/Resources/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="/Resources/Themes/DefaultStyles.xaml" />
                <ResourceDictionary Source="/Resources/Themes/Colors.xaml"/>

                <!-- Tus temas personalizados - se cargarán dinámicamente -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>