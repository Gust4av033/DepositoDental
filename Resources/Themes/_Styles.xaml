<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- ¡LA CLAVE ESTÁ AQUÍ! Cargamos los estilos base de la librería ANTES de usarlos. -->
        <!-- Esto garantiza que cuando se usan los "BasedOn", los recursos ya existen. -->
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Estilo para el cuerpo principal de las ventanas/vistas -->
    <Style x:Key="App.Window.Main" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
    </Style>
    <Style x:Key="App.UserControl.Main" TargetType="UserControl">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
    </Style>

    <!-- Estilo Base para Botones -->
    <Style x:Key="App.Button.Primary" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="40"/>
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- Estilos para otros controles -->
    <Style x:Key="App.TextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}"/>
    <Style x:Key="App.PasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
    <Style x:Key="App.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}"/>
    <Style x:Key="App.DatePicker" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}"/>
    <Style x:Key="App.Calendar" TargetType="Calendar" BasedOn="{StaticResource MaterialDesignCalendarPortrait}"/>
    <Style x:Key="App.Slider" TargetType="Slider" BasedOn="{StaticResource MaterialDesignSlider}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style x:Key="App.ProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignLinearProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style x:Key="App.TreeView" TargetType="TreeView" BasedOn="{StaticResource MaterialDesignTreeView}"/>
    <Style x:Key="App.GroupBox" TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignGroupBox}"/>
    <Style x:Key="App.TabControl" TargetType="TabControl" BasedOn="{StaticResource MaterialDesignTabControl}"/>

    <!-- Estilo para el DataGrid -->
    <Style x:Key="App.DataGrid" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>