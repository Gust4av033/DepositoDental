<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === PALETA DE COLORES DARK MINIMALIST === -->

    <!-- Colores Base -->
    <Color x:Key="Color.Background.Primary">#1a1a1a</Color>
    <Color x:Key="Color.Background.Secondary">#2d2d2d</Color>
    <Color x:Key="Color.Background.Tertiary">#3d3d3d</Color>
    <Color x:Key="Color.Background.Card">#252525</Color>
    <Color x:Key="Color.Background.Modal">#1f1f1f</Color>

    <!-- Colores de Superficie -->
    <Color x:Key="Color.Surface.Default">#2a2a2a</Color>
    <Color x:Key="Color.Surface.Hover">#3a3a3a</Color>
    <Color x:Key="Color.Surface.Pressed">#4a4a4a</Color>
    <Color x:Key="Color.Surface.Selected">#0d7377</Color>

    <!-- Colores de Texto -->
    <Color x:Key="Color.Text.Primary">#e5e5e5</Color>
    <Color x:Key="Color.Text.Secondary">#b3b3b3</Color>
    <Color x:Key="Color.Text.Tertiary">#808080</Color>
    <Color x:Key="Color.Text.Disabled">#4d4d4d</Color>
    <Color x:Key="Color.Text.OnPrimary">#ffffff</Color>

    <!-- Colores de Acento -->
    <Color x:Key="Color.Accent.Primary">#14a085</Color>
    <Color x:Key="Color.Accent.Secondary">#0d7377</Color>
    <Color x:Key="Color.Accent.Light">#32d9b8</Color>
    <Color x:Key="Color.Accent.Dark">#0a5d61</Color>

    <!-- Colores de Estado -->
    <Color x:Key="Color.Success">#4ade80</Color>
    <Color x:Key="Color.Warning">#facc15</Color>
    <Color x:Key="Color.Error">#f87171</Color>
    <Color x:Key="Color.Info">#60a5fa</Color>

    <!-- Colores de Borde -->
    <Color x:Key="Color.Border.Default">#404040</Color>
    <Color x:Key="Color.Border.Focus">#14a085</Color>
    <Color x:Key="Color.Border.Error">#f87171</Color>
    <Color x:Key="Color.Border.Disabled">#2d2d2d</Color>

    <!-- === BRUSHES PARA USO DIRECTO === -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="Brush.Background.Primary" Color="{StaticResource Color.Background.Primary}"/>
    <SolidColorBrush x:Key="Brush.Background.Secondary" Color="{StaticResource Color.Background.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Background.Card" Color="{StaticResource Color.Background.Card}"/>
    <SolidColorBrush x:Key="Brush.Background.Modal" Color="{StaticResource Color.Background.Modal}"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Surface.Default" Color="{StaticResource Color.Surface.Default}"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}"/>
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="{StaticResource Color.Surface.Pressed}"/>
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Text.OnPrimary" Color="{StaticResource Color.Text.OnPrimary}"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}"/>
    <SolidColorBrush x:Key="Brush.Accent.Secondary" Color="{StaticResource Color.Accent.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Accent.Light" Color="{StaticResource Color.Accent.Light}"/>
    <SolidColorBrush x:Key="Brush.Accent.Dark" Color="{StaticResource Color.Accent.Dark}"/>

    <!-- States -->
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}"/>
    <SolidColorBrush x:Key="Brush.Border.Error" Color="{StaticResource Color.Border.Error}"/>
    <SolidColorBrush x:Key="Brush.Border.Disabled" Color="{StaticResource Color.Border.Disabled}"/>
</ResourceDictionary>
