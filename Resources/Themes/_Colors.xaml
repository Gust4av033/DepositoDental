<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta de Colores Principal -->
    <Color x:Key="PrimaryHueLight">#38bdf8</Color>
    <!-- Celeste Claro -->
    <Color x:Key="PrimaryHueMid">#0ea5e9</Color>
    <!-- Azul Cielo (Principal) -->
    <Color x:Key="PrimaryHueDark">#0284c7</Color>
    <!-- Azul Cielo Oscuro -->

    <Color x:Key="SecondaryAccentColor">#10b981</Color>
    <!-- Verde Esmeralda -->

    <!-- Pinceles (Brushes) para usar en los estilos -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryHueMid}"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}"/>
</ResourceDictionary>
