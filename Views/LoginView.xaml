<Window x:Class="DepositoDental.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:DepositoDental.Helpers"
        mc:Ignorable="d"
        
        Title="Iniciar Sesión" 
        Height="600" 
        Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource Brush.Background.Modal}" 
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                              Opacity="0.3" 
                              BlurRadius="20" 
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <!-- Indicador de Carga -->
            <Border Background="{DynamicResource Brush.Background.Modal}"
                    CornerRadius="12"
                    helpers:VisibilityHelper.IsVisible="{Binding IsLoading}">
                <Grid>
                    <Ellipse Width="60" 
                             Height="60" 
                             Stroke="{DynamicResource Brush.Accent.Primary}" 
                             StrokeThickness="4"
                             StrokeDashArray="12,12">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="LoadingRotation"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360"
                                                         Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="Iniciando sesión..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,120,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                </Grid>
            </Border>

            <!-- Formulario Principal -->
            <StackPanel VerticalAlignment="Center" 
                        Margin="40" 
                        helpers:VisibilityHelper.IsHidden="{Binding IsLoading}">

                <!-- Header con logo -->
                <Border Background="{DynamicResource Brush.Accent.Primary}"
                        CornerRadius="50"
                        Width="100"
                        Height="100"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,30">
                    <Path Data="{StaticResource Icon.Dental}"
                          Fill="White"
                          Width="50"
                          Height="50"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <!-- Título -->
                <TextBlock Text="Depósito Dental" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Sistema de Gestión" 
                           FontSize="14" 
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,0,0,40"/>

                <!-- Campo Usuario -->
                <TextBlock Text="Usuario"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           FontSize="12"
                           FontWeight="Medium"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Height="44"
                         Margin="0,0,0,20"
                         TabIndex="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Campo Contraseña -->
                <TextBlock Text="Contraseña"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           FontSize="12"
                           FontWeight="Medium"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             FontSize="14"
                             Height="44"
                             Margin="0,0,0,8"
                             TabIndex="2">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Light}"/>
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <!-- Mensaje de Error -->
                <Border Background="{DynamicResource Brush.Error}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="0,0,0,20"
                        helpers:VisibilityHelper.IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="White" 
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Botón Login -->
                <Button Content="INICIAR SESIÓN" 
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TabIndex="3"
                        Margin="0,10,0,15">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Light}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Dark}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Botón Crear Usuario -->
                <Button Content="CREAR NUEVO USUARIO" 
                        Command="{Binding ShowCreateUserCommand}"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TabIndex="4"
                        Margin="0,0,0,20">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Toggle de Tema -->
                <Button Click="ThemeToggle_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        Padding="8"
                        Cursor="Hand"
                        ToolTip="Cambiar tema">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Theme}"
                              Fill="{DynamicResource Brush.Text.Tertiary}"
                              Width="16"
                              Height="16"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ThemeButtonText}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   FontSize="12"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- Botón Cerrar -->
            <Button HorizontalAlignment="Right" 
                    VerticalAlignment="Top"
                    Width="32"
                    Height="32"
                    Margin="12"
                    Click="CloseButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Cerrar">
                <Path Data="{StaticResource Icon.Close}"
                      Fill="{DynamicResource Brush.Text.Tertiary}"
                      Width="14"
                      Height="14"/>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="16">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Error}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>