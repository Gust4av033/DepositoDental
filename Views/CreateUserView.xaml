<Window x:Class="DepositoDental.Views.CreateUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:DepositoDental.Helpers"
        mc:Ignorable="d"
        
        Title="Crear Usuario" 
        Height="750" 
        Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource Brush.Background.Modal}" 
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="12" Margin="0,0,0,-104">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                              Opacity="0.3" 
                              BlurRadius="20" 
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <!-- Indicador de Carga -->
            <Border Background="{DynamicResource Brush.Background.Modal}"
                    CornerRadius="12"
                    helpers:VisibilityHelper.IsVisible="{Binding IsLoading}">
                <Grid>
                    <Ellipse Width="60" 
                             Height="60" 
                             Stroke="{DynamicResource Brush.Accent.Primary}" 
                             StrokeThickness="4"
                             StrokeDashArray="12,12">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="LoadingRotation"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360"
                                                         Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="Creando usuario..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,120,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                </Grid>
            </Border>

            <!-- Formulario Principal -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          helpers:VisibilityHelper.IsHidden="{Binding IsLoading}">
                <StackPanel VerticalAlignment="Center" 
                            Margin="40,20">

                    <!-- Header -->
                    <Border Background="{DynamicResource Brush.Accent.Primary}"
                            CornerRadius="50"
                            Width="80"
                            Height="80"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20">
                        <Path Data="{StaticResource Icon.Users }"
                              Fill="White"
                              Width="40"
                              Height="40"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <!-- Título -->
                    <TextBlock Text="Crear Nuevo Usuario" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,0,0,30"/>

                    <!-- Campo Usuario -->
                    <TextBlock Text="Nombre de Usuario *"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12"
                               FontWeight="Medium"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Height="40"
                             Margin="0,0,0,15"
                             TabIndex="1"
                             Style="{StaticResource {x:Type TextBox}}"/>

                    <!-- Campo Email -->
                    <TextBlock Text="Correo Electrónico *"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12"
                               FontWeight="Medium"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Height="40"
                             Margin="0,0,0,15"
                             TabIndex="2"
                             Style="{StaticResource {x:Type TextBox}}"/>

                    <!-- Grid para Nombres -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Primer Nombre *"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PrimerNombre, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14"
                                     Height="40"
                                     TabIndex="3"
                                     Style="{StaticResource {x:Type TextBox}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Primer Apellido *"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PrimerApellido, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14"
                                     Height="40"
                                     TabIndex="4"
                                     Style="{StaticResource {x:Type TextBox}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Campo Teléfono -->
                    <TextBlock Text="Teléfono"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12"
                               FontWeight="Medium"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Height="40"
                             Margin="0,0,0,15"
                             TabIndex="5"
                             Style="{StaticResource {x:Type TextBox}}"/>

                    <!-- Campo Contraseña -->
                    <TextBlock Text="Contraseña *"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12"
                               FontWeight="Medium"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox"
                                 FontSize="14"
                                 Height="40"
                                 Margin="0,0,0,15"
                                 TabIndex="6"
                                 Background="{DynamicResource Brush.Surface.Default}"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border.Default}"
                                 BorderThickness="1"
                                 Padding="12,8"/>

                    <!-- Campo Confirmar Contraseña -->
                    <TextBlock Text="Confirmar Contraseña *"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12"
                               FontWeight="Medium"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 FontSize="14"
                                 Height="40"
                                 Margin="0,0,0,8"
                                 TabIndex="7"
                                 Background="{DynamicResource Brush.Surface.Default}"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border.Default}"
                                 BorderThickness="1"
                                 Padding="12,8"/>

                    <!-- Mensaje de Error -->
                    <Border Background="{DynamicResource Brush.Error}"
                            CornerRadius="4"
                            Padding="12,8"
                            Margin="0,0,0,15"
                            helpers:VisibilityHelper.IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="White" 
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Mensaje de Éxito -->
                    <Border Background="{DynamicResource Brush.Success}"
                            CornerRadius="4"
                            Padding="12,8"
                            Margin="0,0,0,15"
                            helpers:VisibilityHelper.IsVisible="{Binding HasSuccess}">
                        <TextBlock Text="{Binding SuccessMessage}" 
                                   Foreground="White" 
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Botones -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botón Cancelar -->
                        <Button Grid.Column="0"
                                Content="CANCELAR" 
                                Command="{Binding CancelCommand}"
                                Height="44"
                                FontSize="14"
                                FontWeight="SemiBold"
                                TabIndex="9"
                                Background="{DynamicResource Brush.Surface.Default}"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"/>

                        <!-- Botón Crear -->
                        <Button Grid.Column="2"
                                Content="CREAR USUARIO" 
                                Command="{Binding CreateUserCommand}"
                                IsDefault="True"
                                Height="44"
                                FontSize="14"
                                FontWeight="SemiBold"
                                TabIndex="8"
                                Background="{DynamicResource Brush.Accent.Primary}"
                                Foreground="{DynamicResource Brush.Text.OnPrimary}"
                                BorderThickness="0"/>
                    </Grid>

                    <TextBlock Text="* Campos obligatorios"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Botón Cerrar -->
            <Button HorizontalAlignment="Right" 
                    VerticalAlignment="Top"
                    Width="32"
                    Height="32"
                    Margin="12"
                    Command="{Binding CancelCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Cerrar">
                <Path Data="{StaticResource Icon.Close}"
                      Fill="{DynamicResource Brush.Text.Tertiary}"
                      Width="14"
                      Height="14"/>
            </Button>
        </Grid>
    </Border>
</Window>